{
  "expo": {
    "name": "Quickly Livraison",
    "slug": "quickly-livraison",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "quicklylivraison",
    "userInterfaceStyle": "automatic",
    "ios": {
